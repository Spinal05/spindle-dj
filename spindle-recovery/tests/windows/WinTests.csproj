<Project Sdk="Microsoft.NET.Sdk">
  <!-- End-to-end tests that run on real Windows (CI) against SpindleRecovery.exe and its embedded engines. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>WinTests.manifest</ApplicationManifest>
    <SpindleExe Condition="'$(SpindleExe)' == ''">$(MSBuildThisFileDirectory)..\..\bin\SpindleRecovery.exe</SpindleExe>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="SpindleRecovery">
      <HintPath>$(SpindleExe)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
