+/* Spindle Recovery: optional selection list for "filecopy".
+ * When the environment variable TESTDISK_COPY_LIST names a text file
+ * (one absolute path per line, as printed by "list,recursive,fullpathname"),
+ * only the regular files listed there are copied. */
+static char **copy_selection_list=NULL;
+static unsigned int copy_selection_nbr=0;
+static int copy_selection_loaded=0;
+
+static int copy_selection_cmp(const void *a, const void *b)
+{
+  return strcmp(*(char * const *)a, *(char * const *)b);
+}
+
+static void copy_selection_load(void)
+{
+  const char *list_name;
+  FILE *f;
+  char line[4096];
+  unsigned int alloc=0;
+  if(copy_selection_loaded)
+    return;
+  copy_selection_loaded=1;
+  list_name=getenv("TESTDISK_COPY_LIST");
+  if(list_name==NULL || list_name[0]=='\0')
+    return;
+  f=fopen(list_name, "rb");
+  if(f==NULL)
+  {
+    log_error("Unable to open selection list %s\n", list_name);
+    copy_selection_nbr=0;
+    copy_selection_list=(char **)MALLOC(sizeof(char *));
+    return;
+  }
+  copy_selection_list=(char **)MALLOC(sizeof(char *));
+  alloc=1;
+  while(fgets(line, sizeof(line), f)!=NULL)
+  {
+    size_t len=strlen(line);
+    while(len>0 && (line[len-1]=='\n' || line[len-1]=='\r'))
+      line[--len]='\0';
+    if(len==0)
+      continue;
+    if(copy_selection_nbr==alloc)
+    {
+      alloc*=2;
+      copy_selection_list=(char **)realloc(copy_selection_list, alloc*sizeof(char *));
+    }
+    copy_selection_list[copy_selection_nbr++]=strdup(line);
+  }
+  fclose(f);
+  qsort(copy_selection_list, copy_selection_nbr, sizeof(char *), copy_selection_cmp);
+  log_info("Selection list %s: %u entries\n", list_name, copy_selection_nbr);
+}
+
+static int copy_selection_wanted(const char *path)
+{
+  const char *key=path;
+  copy_selection_load();
+  if(copy_selection_list==NULL)
+    return 1;
+  return bsearch(&key, copy_selection_list, copy_selection_nbr, sizeof(char *), copy_selection_cmp)!=NULL;
+}
+
